<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF000000"
    android:keepScreenOn="true">

    <LinearLayout
        android:id="@+id/panes"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <FrameLayout
            android:id="@+id/left_root"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="2"
            android:focusable="true">

            <androidx.media3.ui.PlayerView
                android:id="@+id/left_player"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:focusable="false"
                app:resize_mode="fit"
                app:show_buffering="never"
                app:surface_type="texture_view"
                app:use_controller="false" />

            <View
                android:id="@+id/left_stroke"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/pane_focus"
                android:visibility="invisible" />

            <LinearLayout
                android:id="@+id/left_empty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingStart="28dp"
                android:paddingEnd="28dp">

                <TextView
                    android:id="@+id/left_empty_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-light"
                    android:gravity="center"
                    android:text="@string/pane_left_name"
                    android:textColor="#FFF5F5F7"
                    android:textSize="34sp" />

                <TextView
                    android:id="@+id/left_empty_hint"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:fontFamily="sans-serif"
                    android:gravity="center"
                    android:text="@string/pane_empty_hint"
                    android:textColor="#FF8E8E93"
                    android:textSize="16sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/left_loading"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:visibility="gone">

                <io.github.xfzz7.dualpane.LoadRing
                    android:layout_width="52dp"
                    android:layout_height="52dp" />

                <TextView
                    android:id="@+id/left_loading_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:fontFamily="sans-serif"
                    android:text="@string/pane_opening"
                    android:textColor="#FF8E8E93"
                    android:textSize="16sp"
                    android:visibility="gone" />
            </LinearLayout>

            <TextView
                android:id="@+id/left_volume"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|center_horizontal"
                android:layout_marginBottom="36dp"
                android:background="@drawable/overlay_chip"
                android:fontFamily="sans-serif"
                android:paddingStart="18dp"
                android:paddingTop="8dp"
                android:paddingEnd="18dp"
                android:paddingBottom="8dp"
                android:textColor="#FFF5F5F7"
                android:textSize="16sp"
                android:visibility="gone" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/right_root"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:focusable="true">

            <androidx.media3.ui.PlayerView
                android:id="@+id/right_player"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:focusable="false"
                app:resize_mode="fit"
                app:show_buffering="never"
                app:surface_type="texture_view"
                app:use_controller="false" />

            <View
                android:id="@+id/right_stroke"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/pane_focus"
                android:visibility="invisible" />

            <LinearLayout
                android:id="@+id/right_empty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingEnd="20dp">

                <TextView
                    android:id="@+id/right_empty_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-light"
                    android:gravity="center"
                    android:text="@string/pane_right_name"
                    android:textColor="#FFF5F5F7"
                    android:textSize="34sp" />

                <TextView
                    android:id="@+id/right_empty_hint"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:fontFamily="sans-serif"
                    android:gravity="center"
                    android:text="@string/pane_empty_hint"
                    android:textColor="#FF8E8E93"
                    android:textSize="16sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/right_loading"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:visibility="gone">

                <io.github.xfzz7.dualpane.LoadRing
                    android:layout_width="52dp"
                    android:layout_height="52dp" />

                <TextView
                    android:id="@+id/right_loading_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:fontFamily="sans-serif"
                    android:text="@string/pane_opening"
                    android:textColor="#FF8E8E93"
                    android:textSize="16sp"
                    android:visibility="gone" />
            </LinearLayout>

            <TextView
                android:id="@+id/right_volume"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|center_horizontal"
                android:layout_marginBottom="36dp"
                android:background="@drawable/overlay_chip"
                android:fontFamily="sans-serif"
                android:paddingStart="18dp"
                android:paddingTop="8dp"
                android:paddingEnd="18dp"
                android:paddingBottom="8dp"
                android:textColor="#FFF5F5F7"
                android:textSize="16sp"
                android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>

    <View
        android:id="@+id/handle"
        android:layout_width="7dp"
        android:layout_height="92dp"
        android:layout_gravity="center_vertical|start"
        android:background="@drawable/split_handle"
        android:defaultFocusHighlightEnabled="false"
        android:focusable="true"
        android:visibility="invisible" />

    <TextView
        android:id="@+id/exit_hint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="46dp"
        android:background="@drawable/overlay_chip"
        android:fontFamily="sans-serif"
        android:paddingStart="22dp"
        android:paddingTop="10dp"
        android:paddingEnd="22dp"
        android:paddingBottom="10dp"
        android:text="@string/back_again_to_exit"
        android:textColor="#FFF5F5F7"
        android:textSize="18sp"
        android:visibility="gone" />

    <FrameLayout
        android:id="@+id/menu"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#99000000"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/menu_card"
            android:layout_width="460dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="@drawable/menu_card"
            android:orientation="vertical"
            android:paddingStart="14dp"
            android:paddingTop="22dp"
            android:paddingEnd="14dp"
            android:paddingBottom="14dp">

            <TextView
                android:id="@+id/menu_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingBottom="8dp"
                android:textColor="#FF8E8E93"
                android:textSize="15sp" />

            <ScrollView
                android:id="@+id/menu_scroll"
                android:layout_width="match_parent"
                android:layout_height="420dp">

                <LinearLayout
                    android:id="@+id/menu_list"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </ScrollView>
        </LinearLayout>
    </FrameLayout>

    <FrameLayout
        android:id="@+id/guide"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="true"
        android:defaultFocusHighlightEnabled="false"
        android:focusable="false"
        android:visibility="gone">

        <io.github.xfzz7.dualpane.GuideMask
            android:id="@+id/guide_mask"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <LinearLayout
            android:id="@+id/guide_card"
            android:layout_width="440dp"
            android:layout_height="wrap_content"
            android:layout_gravity="start|top"
            android:background="@drawable/menu_card"
            android:orientation="vertical"
            android:paddingStart="28dp"
            android:paddingTop="20dp"
            android:paddingEnd="28dp"
            android:paddingBottom="18dp">

            <TextView
                android:id="@+id/guide_step"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif"
                android:textColor="#FF8E8E93"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/guide_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:fontFamily="sans-serif-light"
                android:textColor="#FFF5F5F7"
                android:textSize="28sp" />

            <TextView
                android:id="@+id/guide_body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:fontFamily="sans-serif"
                android:lineSpacingExtra="5dp"
                android:textColor="#FFC7C7CC"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/guide_hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:fontFamily="sans-serif"
                android:text="@string/guide_confirm_continue"
                android:textColor="#FF8E8E93"
                android:textSize="15sp" />
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
